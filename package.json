{
  "name": "zayed-portfolio",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node init && node scripts/dev.mjs",
    "build": "node init && next build",
    "start": "node init && next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "format": "prettier --write src tests scripts docs *.json *.ts *.mjs",
    "format:check": "prettier --check src tests scripts docs *.json *.ts *.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "debug:mail": "node scripts/debug-mail.mjs",
    "build:sites": "node init && node scripts/build-sites.mjs"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "gsap": "3.15.1",
    "jwt-decode": "4.0.0",
    "lenis": "1.3.27",
    "lucide-react": "0.476.0",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0",
    "esbuild": "0.28.2"
  }
}
