# Public origin for metadata, canonical links, robots and sitemap.
# Set this to the final domain and rebuild when it changes.
NEXT_PUBLIC_SITE_URL=https://zayed-portfolio-app.netlify.app

# Contact form: use server-side environment variables only.
# EMAIL_PASS is a provider-specific app password or SMTP credential.
EMAIL_USER=
EMAIL_PASS=
# Optional. Defaults to EMAIL_USER.
EMAIL_TO=

# Omit SMTP_HOST to use Gmail. Set these for another authenticated SMTP service.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# Legacy owner authentication integration, preserved for future dashboard work.
# No dashboard pages or password-reset backend are included in this portfolio.
BACKEND_URL=
