{
  "mcpServers": {
    "figma": {
      "url": "http://127.0.0.1:3845/sse",
      "transport": "sse"
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "${DATABASE_URL}"]
    },
    "gitnexus": {
      "command": "npx",
      "args": ["-y", "gitnexus", "mcp"]
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    }
  }
}
